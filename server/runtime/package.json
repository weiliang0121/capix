{
  "name": "@capix/server-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./construction": {
      "types": "./dist/construction.d.ts",
      "import": "./dist/construction.js"
    },
    "./recording": {
      "types": "./dist/recording.d.ts",
      "import": "./dist/recording.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capix/protocol": "workspace:*",
    "es-toolkit": "1.52.0",
    "@capix/resources": "workspace:*",
    "@capix/structure": "workspace:*",
    "@capix/contracts": "workspace:*",
    "@capix/changes": "workspace:*",
    "@capix/records": "workspace:*",
    "@capix/checkpoint": "workspace:*",
    "@capix/invocation": "workspace:*"
  }
}
