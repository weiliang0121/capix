{
  "name": "@capix/records",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./construction": {
      "types": "./dist/construction.d.ts",
      "import": "./dist/construction.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capix/contracts": "workspace:*",
    "@capix/changes": "workspace:*",
    "@capix/protocol": "workspace:*",
    "es-toolkit": "1.52.0",
    "@capix/resources": "workspace:*"
  },
  "description": "Optional recording entities and resource contracts for CAPiX.",
  "license": "MIT",
  "author": "wei.liang (https://github.com/weiliang0121)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiliang0121/capix.git",
    "directory": "server/records"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
