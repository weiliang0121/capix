{
  "name": "@capix/observer-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "import": "./dist/conversation.js"
    },
    "./observation": {
      "types": "./dist/observation.d.ts",
      "import": "./dist/observation.js"
    },
    "./assembly": {
      "types": "./dist/assembly.d.ts",
      "import": "./dist/assembly.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capix/protocol": "workspace:*",
    "es-toolkit": "1.52.0",
    "@capix/server-runtime": "workspace:*",
    "zod": "4.6.5",
    "@capix/resources": "workspace:*",
    "@capix/structure": "workspace:*",
    "@capix/observer-content": "workspace:*",
    "@capix/contracts": "workspace:*",
    "@capix/changes": "workspace:*",
    "@capix/memory": "workspace:*",
    "@capix/transcript": "workspace:*",
    "@capix/view": "workspace:*",
    "@capix/measurement": "workspace:*"
  }
}
