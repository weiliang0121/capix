{
  "name": "@weiliang0121/capix-runtime",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./construction": {
      "types": "./dist/construction.d.ts",
      "import": "./dist/construction.js"
    },
    "./recording": {
      "types": "./dist/recording.d.ts",
      "import": "./dist/recording.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/test/run.mjs --package ."
  },
  "dependencies": {
    "es-toolkit": "1.52.0",
    "@weiliang0121/capix-resources": "workspace:*",
    "@weiliang0121/capix-structure": "workspace:*",
    "@weiliang0121/capix-contracts": "workspace:*",
    "@weiliang0121/capix-changes": "workspace:*",
    "@weiliang0121/capix-records": "workspace:*",
    "@weiliang0121/capix-checkpoint": "workspace:*",
    "@weiliang0121/capix-invocation": "workspace:*",
    "@weiliang0121/capix-interaction": "workspace:*",
    "@weiliang0121/capix-diagnostics": "workspace:*"
  },
  "description": "Structure binding, resource assembly, and Runner for CAPiX.",
  "license": "MIT",
  "author": "wei.liang (https://github.com/weiliang0121)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiliang0121/capix.git",
    "directory": "packages/runtime"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@weiliang0121/capix-model-exchanges": "workspace:*",
    "@weiliang0121/capix-transcript": "workspace:*",
    "@weiliang0121/capix-memory": "workspace:*",
    "@weiliang0121/capix-measurement": "workspace:*",
    "@weiliang0121/capix-view": "workspace:*",
    "@weiliang0121/capix-model-provider": "workspace:*"
  }
}
