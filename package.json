{
  "name": "capix-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.7.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test \"test/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
