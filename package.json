{
  "name": "capix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.7.1"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "start": "node --env-file-if-exists=.env services/observer/dist/start.js",
    "dev": "pnpm --filter @capix/observer-app dev",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "tsc -p apps/observer/tsconfig.test.json && node --test \"test/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm typecheck && pnpm test:unit && pnpm format:check"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "@capix/protocol": "workspace:*",
    "@capix/server-runtime": "workspace:*",
    "@capix/observer-service": "workspace:*",
    "zod": "4.6.5",
    "@capix/client-runtime": "workspace:*",
    "@capix/client-http": "workspace:*",
    "@capix/resources": "workspace:*",
    "@capix/structure": "workspace:*",
    "@capix/contracts": "workspace:*",
    "@capix/changes": "workspace:*",
    "@capix/transcript": "workspace:*",
    "@capix/memory": "workspace:*",
    "@capix/view": "workspace:*",
    "@capix/measurement": "workspace:*",
    "@capix/observer-content": "workspace:*",
    "@capix/records": "workspace:*",
    "@capix/checkpoint": "workspace:*",
    "@capix/invocation": "workspace:*",
    "@capix/interaction": "workspace:*",
    "@capix/diagnostics": "workspace:*"
  }
}
