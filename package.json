{
  "name": "capix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.7.1"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm build && pnpm test:packages && pnpm test:repository",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm typecheck && pnpm test:packages && pnpm test:repository && pnpm examples:check && pnpm docs:build && pnpm format:check",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --registry=https://registry.npmjs.org",
    "release:build": "node scripts/release/build.mjs",
    "release:check": "node scripts/release/check.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "integration:pack": "node scripts/integration/pack.mjs",
    "test:packages": "node scripts/test/run.mjs --packages",
    "test:repository": "node scripts/test/run.mjs --repository",
    "integration:check": "node scripts/integration/check.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/docs/check.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/docs/check.mjs",
    "examples:check": "node scripts/examples/check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.19.11",
    "@weiliang0121/capix-checkpoint": "workspace:*",
    "@weiliang0121/capix-contracts": "workspace:*",
    "@weiliang0121/capix-diagnostics": "workspace:*",
    "@weiliang0121/capix-interaction": "workspace:*",
    "@weiliang0121/capix-invocation": "workspace:*",
    "@weiliang0121/capix-memory": "workspace:*",
    "@weiliang0121/capix-model-exchanges": "workspace:*",
    "@weiliang0121/capix-model-provider": "workspace:*",
    "@weiliang0121/capix-records": "workspace:*",
    "@weiliang0121/capix-resources": "workspace:*",
    "@weiliang0121/capix-runtime": "workspace:*",
    "@weiliang0121/capix-structure": "workspace:*",
    "@weiliang0121/capix-tool": "workspace:*",
    "@weiliang0121/capix-transcript": "workspace:*",
    "@weiliang0121/capix-view": "workspace:*",
    "esbuild": "0.28.2",
    "mermaid": "12.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "zod": "4.6.5"
  },
  "license": "MIT",
  "author": "wei.liang (https://github.com/weiliang0121)"
}
