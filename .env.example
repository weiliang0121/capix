# Copy this file to .env and set the key locally. Never put the key in the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Local admission budget, not a declaration of the provider's full context size.
CONTEXT_BUDGET=32768
MAX_OUTPUT_TOKENS=1536
MODEL_TIMEOUT_MS=90000
PORT=4317
# Optional, host-managed local directory for bounded UTF-8 reads and new result files.
# The directory must already exist. Leave empty to disable file tasks.
CAPIX_FILES_ROOT=
